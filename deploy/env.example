# Copy to /opt/halfspace/.env on the server and fill in. Never commit the real file.
HALFSPACE_ADMIN_TOKEN=
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# optional, free key from https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=
# only if the frontend is ever served from a different address than the API
HALFSPACE_ALLOWED_ORIGINS=
