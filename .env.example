# Free key from https://console.groq.com -> API Keys. Used only by the agent (scripts/ask_agent.py).
GROQ_API_KEY=
# Optional comma-separated fallback chain (each model has its own Groq rate limit).
# Default: openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# GROQ_MODELS=

# Admin portal token (16+ characters). Leave empty to keep /admin disabled. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HALFSPACE_ADMIN_TOKEN=

# Optional: free key from https://www.football-data.org/client/register for official fixtures/standings (12 competitions).
FOOTBALL_DATA_KEY=

# Impect open data is under restricted terms (no commercial use or redistribution). Leave unset unless you have read them.
# HALFSPACE_ACCEPT_IMPECT_TERMS=yes
